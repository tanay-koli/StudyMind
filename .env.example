###############################################################################
# StudyMind — Cognee Cloud Configuration
#
# Copy this file to .env and fill in your own credentials.
# Get your API key and tenant URL from the Cognee Cloud console:
#   https://app.cognee.ai → Integrations → API / MCP
###############################################################################

# -- Cognee Cloud -------------------------------------------------------------
COGNEE_BASE_URL=https://tenant-YOUR_TENANT_ID.aws.cognee.ai
COGNEE_API_KEY=your_api_key_here

# -- Misc ---------------------------------------------------------------------
LOG_LEVEL=INFO
