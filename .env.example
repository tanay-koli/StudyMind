###############################################################################
# StudyMind — Configuration
#
# Copy this file to .env and fill in your own credentials.
# Get your Cognee API key and tenant URL from the Cognee Cloud console:
#   https://app.cognee.ai → Integrations → API / MCP
###############################################################################

# -- Cognee Cloud -------------------------------------------------------------
COGNEE_BASE_URL=https://tenant-YOUR_TENANT_ID.aws.cognee.ai
COGNEE_API_KEY=your_api_key_here

# -- LLM (any LiteLLM model string) -------------------------------------------
# Local default: run `ollama pull qwen2.5:7b` first. Alternatives:
#   ollama/gemma3:4b, groq/<model>, openrouter/<model>, anthropic/<model>
LLM_MODEL=ollama/qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# -- Storage ------------------------------------------------------------------
# DATABASE_URL=sqlite:///data/studymind.db

# -- Tracing (optional; enabled only when both keys are set) ------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# -- UI -----------------------------------------------------------------------
API_URL=http://localhost:8000
