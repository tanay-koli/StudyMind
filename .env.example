###############################################################################
# StudyMind — Configuration
#
# Copy this file to .env to change a default. Everything runs locally.
###############################################################################

# -- LLM (any LiteLLM model string) -------------------------------------------
# Local default: run `ollama pull qwen2.5:7b` first. Alternatives:
#   ollama/gemma3:4b, groq/<model>, openrouter/<model>, anthropic/<model>
LLM_MODEL=ollama/qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# -- Retrieval ----------------------------------------------------------------
EMBED_MODEL=bge-small        # bge-small | nomic (reindexes on next start)
CHUNKER=structure            # structure | fixed (applies to new ingests)
RETRIEVER=hybrid             # hybrid | dense (eval baseline)

# -- Storage ------------------------------------------------------------------
# DATABASE_URL=sqlite:///data/studymind.db
# QDRANT_PATH=data/qdrant

# -- Tracing (optional; enabled only when both keys are set) ------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# -- UI -----------------------------------------------------------------------
API_URL=http://localhost:8000
